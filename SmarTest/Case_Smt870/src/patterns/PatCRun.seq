
sequence PatCRun {

    parallel RC1
    {
        sequential
        {
          patternCall patterns.PatC1;
        }
    }

    bypassable parallel RC2
    {
      sequential
      {
        patternCall patterns.PatC2;
        patternCall patterns.PatC3;
      }
    }

    bypassable parallel RC3
    {
        sequential S3
        {

            patternCall patterns.PatC4;
            patternCall patterns.PatC5;
            patternCall patterns.PatC6;
        }
    }
}
