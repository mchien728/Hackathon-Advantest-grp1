flow sensor {

    setup {
            suite sensor1 calls CustomTML.ContiTest
            {
            dpsSignals = "VCC";
            dpsVrange= 1;
            dpsIrange= 0.01;
            dpsSignalsIclamp= 0.01;
            measureMode= Parallel;
            specParameters=  setupRef(common.GroupAndVar);
            measurement.specification= setupRef(common.MainSpec);
            signals= "CP";
            }
            suite sensor2 calls CustomTML.ContiTest
            {
            dpsSignals = "VCC";
            dpsVrange= 1;
            dpsIrange= 0.01;
            dpsSignalsIclamp= 0.01;
            measureMode= Parallel;
            specParameters=  setupRef(common.GroupAndVar);
            measurement.specification= setupRef(common.MainSpec);
            signals= "DS0";
            }
            suite sensor3 calls CustomTML.ContiTest
            {
            dpsSignals = "VCC";
            dpsVrange= 1;
            dpsIrange= 0.01;
            dpsSignalsIclamp= 0.01;
            measureMode= Parallel;
            specParameters=  setupRef(common.GroupAndVar);
            measurement.specification= setupRef(common.MainSpec);
            signals= "IO4";
            }
            suite sensor4 calls CustomTML.ContiTest
            {
            dpsSignals = "VCC";
            dpsVrange= 1;
            dpsIrange= 0.01;
            dpsSignalsIclamp= 0.01;
            measureMode= Parallel;
            specParameters=  setupRef(common.GroupAndVar);
            measurement.specification= setupRef(common.MainSpec);
            signals= "IO1";
            }

    }


    execute {
        sensor1.execute();
        sensor2.execute();
        sensor3.execute();
        sensor4.execute();
    }
}
