flow TestCase1_Prebind {

    setup {

        suite defineBins calls common.DefineBins {}
        suite importtest calls com.advantest.itee.testtable.testmethod.TestTableReader
        {
            testTablePath= "./TestCase1/TestCase1_Limit.ods";
            limitCategory= "FT";
            logLevelCategory= "FT";
            forceImport = true;
            printToConsole= true;

        }
        suite ReadOreDef calls ACSTML.T_LoadOREDef
        {
            Offline_Data_Def_File= "src/TestCase1/TestCase1_OfflineData.csv";
            PatFailCycle_Def_File= "patfaildef.csv";
            //Offline_delay_Def_File = "src/TestCase1/TestCase1_Wait.csv";
        }
        suite InitStdfDef calls ACSTML.EngSTDFInit
        {

        }
    }

    execute {
        ReadOreDef.execute();
        importtest.execute();
        defineBins.execute();
        if(testProgramVariables.getLong("eng") ==1)
        {
            InitStdfDef.execute();
        }
    }
}
