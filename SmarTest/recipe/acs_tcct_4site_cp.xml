<?xml version="1.0" encoding="UTF-8"?>
<Recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd">
  <!-- Start SmarTest if SmarTest with a specified version has not started yet -->
  <Smartest forceRestart="false" version="soc64_8.7.0.0">
    <ModelFile>./env/model_Smt8</ModelFile>
    <StartMode>OFFLINE</StartMode>
    <ShowSWC>true</ShowSWC>
    <Assignment>
      <!-- Specify environment variables for SmarTest -->
      <Set name="ENV.ST_STARTTIME" value="${ENV.TIMESTAMP}" />
    </Assignment>
  </Smartest>
  
  <!-- Configure the libraries which will be later used in recipe -->
  <Libraries>
    <Library name="GUILib" path="${ENV.XOC_SYSTEM}/lib/liblineDialog.so" />
    <Library name="PartIDLib" path="${ENV.XOC_SYSTEM}/lib/libpartIDIncrement.so" />
    <Library name="LibACS" path="./lib/libacs_tcct.so"/>
  </Libraries>

<LibraryCall function="LibACS.acs_init">
</LibraryCall>
<!-- /* _start_topic_255325_s1 */ -->
  <!-- Create and connect PH session with a specified driver -->
  <EquipmentControl function="START_PHCONTROL">
    <!-- The first input must be GENERIC_93K_DRIVER -->
    <In>GENERIC_93K_DRIVER</In>
    <In>/opt/hp93000/testcell/phcontrol/drivers/Generic_93K_Driver/GenericProber/TEL/</In>
    <In>./env/P12-GPIB-Prober-4-die-256-bin.cfg</In>
    <!-- Specify the wafer description file in the fourth parameter -->
    <In>./wafertyp/Wafer_100Dut</In> 
   </EquipmentControl>
<!-- /* _stop_topic_255325_s1 */ -->

   <TestProgram action="RUN" name="TestCase_Smt870/src/TestCase1/TestCase1_4site_cp.prog" workspace="../workspace" lotType="WAFER_TEST" forceActivate="true"/>

   <LibraryCall function="LibACS.acs_image_check"/>

  <!-- Execute a subrecipe file which specifies detailed lot information -->
  <SubRecipe path="sub.xml" />
  <Assignment>
     <Set name="TC.LOT_ID" value="K12345.00"/>
     <Set name="TC.TEMP" value="25C"/>
     <Set name="TC.PRODUCT_ID" value="V12345"/>
     <Set name="STDF.LOT_ID" value="${TC.LOT_ID}"/>
     <Set name="STDF.TEST_COD" value="CP"/>      
     <Set name="STDF.JOB_REV" value="V1.0.1"/>
     <Set name="STDF.OPER_NAM" value="UserA"/>
     <Set name="STDF.LOAD_ID" value="BoardA"/>
     <Set name="STDF.PART_TYP" value="PartABC"/>
     <Set name="STDF.FABWF_ID" value="K12345-01B2"/>
     <Set name="STDF.FACIL_ID" value="SPIL-3_S"/>
     <Set name="STDF.ENG_ID" value="ABEe884959#K12345"/>
     <Set name="TP.run_ore" value="true"/>
     <Set name="TP.wait_enable" value="false"/>
     <Set name="TP.wait_time" value="5"/>
     <Set name="TP.fail_rate" value="9"/>
     <Set name="TP.eng" value="0"/>

     <Set name="WaferCnt" value="1"/>   
     <Set name="WaferNum" value="0" type="LONG"/>
     <Set name="TDNum" value="0" type="LONG"/>
  </Assignment>
  
  
<Level name="LOT">

<LoopCount>1</LoopCount>
    <!-- Send the command to PH for LOAD_LOT -->
    <EquipmentControl function="LOAD_LOT" />      
 	
    <Level name="WAFER">
      <LoopCount>${WaferCnt}</LoopCount>         
      <EquipmentControl function="LOAD_WAFER" />
      <Assignment>
        <Set name="TDNum" value="0" type="LONG"/>
        <Increment name="WaferNum" value="1"/>
        <Set name="STDF.WAFER_ID" value="W${WaferNum}"/>
        <Set name="TC.datalogPath" value="/tmp/STDF/datalog_${SYS.TESTPROGRAM_NAME}_${TC.LOT_ID}_W${WaferNum}_${ENV.HOSTNAME}_${ENV.TIMESTAMP}" />
       </Assignment>   
       
      <Datalog action="OPEN" type="STDF" path="${TC.datalogPath}.stdf" />      
      
      <Level name="DEVICE">
        <LoopCount>-1</LoopCount>
        <Assignment>
          <Increment name="TDNum" value="1"/>
        </Assignment> 
        <LibraryCall function="LibACS.acs_sot"/>     
        <EquipmentControl function="LOAD_DEVICE" />
        <LibraryCall function="PartIDLib.autoIncrementPartID"/>
        <Testflow action="ExecuteMainflow"/>
        <EquipmentControl function="BIN_DEVICE" />
        <LibraryCall function="LibACS.acs_postbin"/>
       </Level>          
      
      <EquipmentControl function="UNLOAD_WAFER" />
      <Datalog action="CLOSE" type="STDF" path="${TC.datalogPath}.stdf" /> 
    </Level>    
    <!-- After the lot testing is done, send the command to PH for UNLOAD_LOT -->
    <EquipmentControl function="UNLOAD_LOT" />
  </Level>
  
  <!-- Stop the PH session when the recipe execution is done -->
  <EquipmentControl function="STOP_PHCONTROL" />

</Recipe>
