### GLOBAL
#
# <testhead>          ::= TH_1CC | TH_2CC | TH_4CC | TH_8CC
#
# <dut_interface>     ::= SOC_4GROUP | SOC_8GROUP | HSM
#
# <hpib_interface>    ::= <interface_addr>
#
# * The <hpib_interface> identifies the interface used for Tracecal.
#
#
# <operator_console>    ::= <ip_address>
#                           IP Address of the operator console
#
# <ip_address>          ::= <number>.<number>.<number>.<number>
# 
# <device_maintenance>  ::= ON | OFF
#                           Enabling or disabling the device maintenance (refresh) feature.
#                           If it is not specified it will be automatically disabled.
#
# <memory_stacker>    ::= ON | OFF
#                         enable / disable memory stacker feature
#
# <xpressdata>        ::= ON | OFF
#                         enable / disable xpress data mode. Default is OFF
#
# <enhanced_edge_clock>::= ON | OFF
#                         enable / disable enhanced edge clock mode for HSM only. Default is OFF
#
# <memory_pooling>     ::= ON | OFF
#                         enable / disable memory pooling. Default is OFF
#
# <memorytest>        ::= ON | OFF
#                         enable / disable memory test software. Default is OFF
#
# <protocol_aware>    ::= ON | OFF
#                         enable / disable the protocol aware software. Default is OFF
#
# <psrf_pa_library>   ::= ON | OFF
#                         enable / disable PSRF Power Amplifier Library. Default is OFF
#
# <ppRF>               ::= ON | OFF
#                         enable / disable per pin RF feature. Default is OFF
#
# <psrf_4xFE>          ::= ON | OFF
#                         enable / disable PSRF 4x FrontEnds. Default is OFF
#
# <triage>            ::= ON | OFF
#                         enable / disable triage software. Default is OFF
#
# <s&s_value_package> ::= ON | OFF
#                         enable / disable S&S value package software. Default is ON
#
# <ore>               ::= ON | OFF
#                         enable / disable Offline Result Emulation feature. Default is ON
#
# <vectorCache>       ::= ON | OFF
#                         enable / disable the vector cache. Default is ON
#
#
# <tim_bundle>        ::= timing_bundle = <t_bundle>
# <t_bundle>          ::= w32-d8-r6 | w256-d8-r8
