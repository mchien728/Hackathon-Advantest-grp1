# <mux_pogoblocks>    ::= the mux board pogo numbers
#                         allowed pogoblocks: 866,868,870,872,874,876,878,880,881,883,885,887,889,891,893,895

### POGOCABLING
#
# <slot>              ::= 101..118, 201..218, 301..318, 401..418
#                         Format of the number is CSS, whereas C the number of the control segment 
#                         and SS the number of the Slot represents. 
#                         Note: the clockboard slot is not counted.
#
# <pogocabling_feature> ::= <pogoblocks> | <pogocable_type> | <pogocable_subtype> | <pogocable_config>
#
# <pogoblocks>        ::= double quoted string, defining ordered list of pogoblocks.
#                         - allowed pogoblocks: 101..132, 201..232,
#                                301..332, 401..432, 501..532,
#                                601..632, 701..732, 801..832
#                         - list is specified with character ','. E.g.: "101, 103"
#                         - ranges are specified with character '-'. E.g.: "228-232"
#                         - ranges and list specifications can be mixed.
#                           E.g. "101, 210-212"
#                         NOTE:
#                         To find out how many pogoblocks are used for a specific HW type, 
#                         you can run the script:
#                         /opt/hp93000/soc/system/config/xoc.hw.cor.detection.ZSIoCardFactory/getDensityForVariants
#
# <pogocable_type>    ::= type=<allowed_pogocable_type>
#
# <allowed_pogocable_type> ::= SD | HD1x256 | HD2x32 | HD4x32 | VHD1x128 | redirect
#                              HD1x256 restrictions:
#                                  4 pogoblock numbers with predefined order:
#                                  "a, a+400, a-200, a+200" 
#                                  with a = 301..332 or 401..432.
#                              HD2x32 restrictions:
#                                  4 pogoblock numbers with predefined order:
#                                  "a, a+400, b, b+400"     
#                                  with a, b = 3 digit numbers of format [1..4][01..32]
#                              HD4x32 restrictions:
#                                  8 pogoblock numbers with predefined order:
#                                  "a, b, c, d, a+400, b+400, c+400, d+400"
#                                  with a, b, c, d = 3 digit numbers of format [1..4][01..32]
#                              VHD1x128 restrictions:
#                                   8 pogoblock numbers with predefined order:
#                                   "x, x+400, x+32, x+432, x+1, x+401, x+33, x+433"
#                                   with x = yzz; y = [1..4] z = [01..32]
#                              HD4x32DPS restrictions:
#                                  8 pogoblock numbers with predefined order:
#                                  "a, a+400, b, b+400, c, c+400, d, d+400"
#                                  with a, b, c, d = 3 digit numbers of format [1..4][01..32]
#                              VHD4x32 restrictions:
#                                   8 pogoblock numbers with predefined order:
#                                   "a, a+432, b, b+432, c, c+432, d, d+432"
#                                   with a, b, c, d = 3 digit numbers of format [1..4][01..32]
# <pogocable_subtype> ::= subtype=E8013GUL | subtype=E8013QUL | subtype=E8023PC | subtype=E8023PD | subtype=E8023PE | subtype=E8023PF
#
# <pogocable_config>  ::= config="<some_data>"
#                         config string description is depending on subtype
#
### IOCHANNEL
#
# <ch_1>,<ch_2>       ::= <board><channel>
# <board>             ::= 101..132, 201..232, 301..332, 401..432,
#                         501..532, 601..632, 701..732, 801..832
# <channel>           ::= 01..16
#
# <ioch_feature>      ::= <HW> | <speed> |  <seq_mem_len> | <para_mem_len>  | <apg_mem_len>  |<diff> | <tia> | <tmu> | <loopback>
# <HW>                ::= HW = <HW_type>
# <HW_type>	      ::= PS800 | PS3600 | PS400 | PS9G | PS1600 | HSM3600 | HSM2200 | HSM3G | HSM4G | HSM6800 | HSM8G
#
# <speed>	      ::= speed = <frequency> [<freq_unit>]
#                         | speed = max-rate
# <frequency>	      ::= <integer>
# <freq_unit>	      ::= Mbps | Gbps
#
# <sequencer_mem_len> ::= smem = <size> [<mem_unit>]
# <para_mem_len>      ::= paramem = <size> [<mem_unit>]
# <apg_mem_len>       ::= apgmem = <size> [<mem_unit>]
# <size>              ::= <integer>
# <mem_unit>          ::= K | M | G
#
# <timing_bundle>     ::= tim = <t_bundle>
# <t_bundle>          ::= w32-d8-r6 | w256-d8-r8
#
# <diff>              ::= diff
#
# <tia>               ::= tia
#
# <tmu>               ::= tmu
#
# <loopback>          ::= loopback = <frequency> [<freq_unit>]
#                         | loopback
#
### ANALOGBOARD
#
# <bd_1>,<bd_2>       ::= <board>
# <anabd_type>        ::= HXA | MC[A-C] | MCE | MCL | RF[A-D] | LPN
# <anabd_feature>     ::= <core> | <speed> | <loopback> | <pattern>
# <core>              ::= Total number of cores you want to use
# <config>            ::= Extra info about the board such as options etc.
#                         (ex. STD | MINI_ME | MULT | ...)
# <speed>             ::= speed = <frequency> [<freq_unit>]
# <frequency>	      ::= <integer>
# <freq_unit>	      ::= Mbps| Gbps
#
# <loopback>          ::= loopback
# <pattern>           ::= pattern
# <mode>              ::= MCA | MCB
# <psrf>              ::= psrf
#
#
# * <config> information is/(is not) required based on <anabd_type>.
# * <core>   information is optional.
# * <loopback> entry is only valid for HXA boards
# * <pattern>  entry is only valid for HXA boards
# * <speed>    entry is only valid for HXA boards
#
### BOARDCONF
#
# <mod_1>,<mod_2>      ::= <board><module>
# <board>              ::= 101..132,201..232, ... , 801..832
# <module>             ::= 1..9
# <anabd_type>         ::= MC[A-C] | MCE | MCL | HXA
# <board_feature>      ::= <MCX_features>[, <MCX_speed>]  | <HXA_features> 
# <MCX_features>       ::= mytpe = <module_type>
# <module_type>        ::= SRC[A-B]| SRCE | SRCL | MES[A-C] | MESE | MESL
# <MCX_speed>          ::= speed = 100 | 110 | 200 | 500 Msps
# <HXA_features>       ::= <type> = <list>
# <type>               ::= muxd | termd | clkd | muxr | clkr | loopback
# <list>               ::= <ch> | <ch>/<ch> | <ch>/<ch>/<ch>/<ch>
# <ch>                 ::= <board><channel>
# <channel>            ::= 01..16
#
### ETC
#
# REFERENCECLOCK
#  <input>                  ::= INTERNAL | EXTERNAL
#
# * INTERNAL: Select internal source for 10 MHz reference clock signal.
#
# * EXTERNAL: Select external (RF) source for 10 MHz reference clock signal.
#             (External clock generator must be connected.)
#
#  <output_at_rf_connector> ::= ON | OFF
#
# * ON :      The reference clock signal is output at the RF connector ring
#
# * OFF:      The reference clock signal is not output at the RF connector ring
#
### DPS
#
# <dps_1>,<dps_2>     ::= 1..8 | 10101..83216
# <dps_type>          ::= GPDPS | HVDPS | HCDPS | MSDPS | XCPS | SE-UDPS | DCS-DPS32 | DCS-VI32 | DCS-UHC4 | DCS-UHC4T | DCS-DPS128HC | DCS-DPS128HV | DCS-PVI8 | DCS-AVI64
# <dps_ch>            ::= 4|8
#
# * The <dps_ch> is used only for MSDPS to define the channel mode.
#
#
