# <unit>              ::= Mbps
#
#
# <utility_lines>     ::= (64|128|256) [, type=(static|sequencer_controlled)]
#                                      [, pogo_size=(16|32)]
#
# <mux_boards>        ::= <mux_nr_of_boards>, type=<mux_board_type>, pogoblocks=<mux_pogoblocks>
